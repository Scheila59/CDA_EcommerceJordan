{% extends 'base.html.twig' %}

{% block body %}
<div class="container my-5">
    <h2>Votre panier</h2>

    {% if cart is empty %}
        <div class="alert alert-info">Votre panier est vide.</div>
    {% else %}
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>Produit</th>
                    <th>Quantité</th>
                    <th>Prix unitaire</th>
                    <th>Total</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                {% for item in cart %}
                    <tr>
                        <td>{{ item.product.name }}</td>
                        <td>{{ item.quantity }}</td>
                        <td>{{ item.product.price|number_format(2, ',', ' ') }} €</td>
                        <td>{{ (item.product.price * item.quantity)|number_format(2, ',', ' ') }} €</td>
                        <td>
                            <a href="{{ path('cart_remove', {id: item.product.id}) }}" class="btn btn-warning btn-sm">Retirer 1</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total :</th>
                    <th colspan="2">{{ total|number_format(2, ',', ' ') }} €</th>
                </tr>
            </tfoot>
        </table>
        <a href="{{ path('cart_clear') }}" class="btn btn-danger">Vider le panier</a>
    {% endif %}
</div>
{% endblock %}
