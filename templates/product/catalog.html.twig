{% extends 'base.html.twig' %}

{% block title %}Catalogue des Produits{% endblock %}

{% block body %}
<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <form method="get" class="d-flex align-items-center">
                <label for="type-filter" class="me-2">Filtrer par type :</label>
                <select name="type" id="type-filter" class="form-select w-auto me-2" onchange="this.form.submit()">
                    <option value="0">Tous les types</option>
                    {% for type in types %}
                        <option value="{{ type.id }}" {% if selectedType == type.id %}selected{% endif %}>
                            {{ type.label }}
                        </option>
                    {% endfor %}
                </select>
                {# Suppression du bouton Filtrer #}
            </form>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        {% for product in products %}
        <div class="col">
            <div class="card h-100 d-flex flex-column">
                <img src="{{ product.image ?: 'https://dummyimage.com/450x300/dee2e6/6c757d.jpg' }}" 
                    class="card-img-top product-image" 
                    alt="{{ product.name }}">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-center">{{ product.name }}</h5>
                    <p class="card-text text-muted text-center">
                        {{ product.description|slice(0, 100) }}{% if product.description|length > 100 %}...{% endif %}
                    </p>
                    <div class="mt-auto">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-danger">{{ product.price }}€</span>
                            <span class="badge bg-secondary">Stock : {{ product.quantity }}</span>
                            <span class="badge bg-secondary">{{ product.types.label }}</span>
                        </div>
                        <div class="card-footer text-center bg-transparent border-0 p-0">
                            {% if product.quantity > 0 %}
                                <a href="{{ path('cart_add', {id: product.id}) }}" class="btn btn-success w-100 fw-bold py-2 shadow-sm btn-zoom">
                                    <i class="bi bi-cart-plus me-1"></i> Ajouter au panier
                                </a>
                            {% else %}
                                <span class="badge bg-danger w-100">Rupture de stock</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>

    {% if products is empty %}
    <div class="alert alert-info text-center" role="alert">
        Aucun produit trouvé pour ce type.
    </div>
    {% endif %}
</div>
{% endblock %} 